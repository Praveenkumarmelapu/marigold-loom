{
  "name": "marigold-loom",
  "version": "1.0.0",
  "private": true,
  "description": "ZAVIRO - full-stack fashion e-commerce app (React, Express, MongoDB, Cloudinary)",
  "main": "server/src/index.js",
  "scripts": {
    "dev:server": "node --watch server/src/index.js",
    "dev:client": "npm --prefix client run dev",
    "start": "node server/src/index.js",
    "seed": "node server/scripts/seed.js",
    "test:api": "node server/scripts/smoke-test.js",
    "build": "npm --prefix client install --include=dev && npm --prefix client run build"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.5.1",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.9.0",
    "multer": "^1.4.5-lts.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0"
  }
}
